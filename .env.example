POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://aegis:replace-with-a-local-password@localhost:55432/aegisbid
NATS_URL=nats://localhost:54222
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMISSION_SERVICE_KEY=replace-with-an-independent-32-character-service-key
# Optional random key of at least 32 characters for browser setup of the first admin.
ADMIN_SETUP_KEY=
DEMO_PASSWORD=replace-with-a-demo-password
ENVIRONMENT=development
ENABLE_CHAOS=false
WEB_PORT=18080
NATS_PORT=54222
BACULA_PASSWORD=replace-with-24-or-more-url-safe-random-characters
GRAFANA_PASSWORD=replace-with-a-random-password
# Independent backup host only; never inject these into application services.
BACKUP_BUCKET=replace-with-independent-backup-bucket
BACKUP_ENCRYPTION_KEY=replace-with-64-random-hex-digits-kept-outside-the-repository
