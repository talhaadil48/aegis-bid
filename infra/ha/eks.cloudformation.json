{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AegisBid three-zone private-node EKS foundation; independent offsite account is provisioned separately. Creates billable infrastructure.",
  "Parameters": {
    "ClusterName": {
      "Type": "String",
      "Default": "aegis-prod"
    },
    "KubernetesVersion": {
      "Type": "String",
      "Default": "1.34"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "m6i.xlarge"
    },
    "AdminCidr": {
      "Type": "String",
      "AllowedPattern": "^(?:\\d{1,3}\\.){3}\\d{1,3}/(?:[1-9]|[12]\\d|3[0-2])$",
      "Description": "Restricted administrator IPv4 CIDR, preferably /32. No world-open default."
    },
    "AdminPrincipalArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws[^:]*:iam::\\d{12}:role/.+$",
      "Description": "Existing authorized administrator role"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Internet": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "AttachInternet": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Internet"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Internet"
        }
      },
      "DependsOn": "AttachInternet"
    },
    "Public0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": {
              "Fn::Sub": "kubernetes.io/cluster/${ClusterName}"
            },
            "Value": "shared"
          },
          {
            "Key": "kubernetes.io/role/elb",
            "Value": "1"
          }
        ]
      }
    },
    "Private0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.10.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": {
              "Fn::Sub": "kubernetes.io/cluster/${ClusterName}"
            },
            "Value": "shared"
          },
          {
            "Key": "kubernetes.io/role/internal-elb",
            "Value": "1"
          }
        ]
      }
    },
    "PublicAssociation0": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Public0"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "Address0": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "Nat0": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "Address0",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "Public0"
        }
      },
      "DependsOn": "InternetRoute"
    },
    "Routes0": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "Egress0": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes0"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "Nat0"
        }
      }
    },
    "PrivateAssociation0": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Private0"
        },
        "RouteTableId": {
          "Ref": "Routes0"
        }
      }
    },
    "Public1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": {
              "Fn::Sub": "kubernetes.io/cluster/${ClusterName}"
            },
            "Value": "shared"
          },
          {
            "Key": "kubernetes.io/role/elb",
            "Value": "1"
          }
        ]
      }
    },
    "Private1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": {
              "Fn::Sub": "kubernetes.io/cluster/${ClusterName}"
            },
            "Value": "shared"
          },
          {
            "Key": "kubernetes.io/role/internal-elb",
            "Value": "1"
          }
        ]
      }
    },
    "PublicAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Public1"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "Address1": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "Nat1": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "Address1",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "Public1"
        }
      },
      "DependsOn": "InternetRoute"
    },
    "Routes1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "Egress1": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes1"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "Nat1"
        }
      }
    },
    "PrivateAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Private1"
        },
        "RouteTableId": {
          "Ref": "Routes1"
        }
      }
    },
    "Public2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.2.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            2,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": {
              "Fn::Sub": "kubernetes.io/cluster/${ClusterName}"
            },
            "Value": "shared"
          },
          {
            "Key": "kubernetes.io/role/elb",
            "Value": "1"
          }
        ]
      }
    },
    "Private2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.42.12.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            2,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": {
              "Fn::Sub": "kubernetes.io/cluster/${ClusterName}"
            },
            "Value": "shared"
          },
          {
            "Key": "kubernetes.io/role/internal-elb",
            "Value": "1"
          }
        ]
      }
    },
    "PublicAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Public2"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "Address2": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "Nat2": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "Address2",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "Public2"
        }
      },
      "DependsOn": "InternetRoute"
    },
    "Routes2": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "Egress2": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes2"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "Nat2"
        }
      }
    },
    "PrivateAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Private2"
        },
        "RouteTableId": {
          "Ref": "Routes2"
        }
      }
    },
    "SecretsKey": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ControlPlaneRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "eks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonEKSClusterPolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "UseSecretsKey",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:DescribeKey",
                    "kms:CreateGrant",
                    "kms:Encrypt",
                    "kms:Decrypt"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SecretsKey",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonEKSWorkerNodePolicy"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonEC2ContainerRegistryPullOnly"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonEKS_CNI_Policy"
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::EKS::Cluster",
      "Properties": {
        "Name": {
          "Ref": "ClusterName"
        },
        "Version": {
          "Ref": "KubernetesVersion"
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "ControlPlaneRole",
            "Arn"
          ]
        },
        "DeletionProtection": true,
        "AccessConfig": {
          "AuthenticationMode": "API",
          "BootstrapClusterCreatorAdminPermissions": false
        },
        "EncryptionConfig": [
          {
            "Provider": {
              "KeyArn": {
                "Fn::GetAtt": [
                  "SecretsKey",
                  "Arn"
                ]
              }
            },
            "Resources": [
              "secrets"
            ]
          }
        ],
        "ResourcesVpcConfig": {
          "SubnetIds": [
            {
              "Ref": "Private0"
            },
            {
              "Ref": "Private1"
            },
            {
              "Ref": "Private2"
            }
          ],
          "EndpointPrivateAccess": true,
          "EndpointPublicAccess": true,
          "PublicAccessCidrs": [
            {
              "Ref": "AdminCidr"
            }
          ]
        },
        "Logging": {
          "ClusterLogging": {
            "EnabledTypes": [
              {
                "Type": "api"
              },
              {
                "Type": "audit"
              },
              {
                "Type": "authenticator"
              },
              {
                "Type": "controllerManager"
              },
              {
                "Type": "scheduler"
              }
            ]
          }
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AdminAccess": {
      "Type": "AWS::EKS::AccessEntry",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "PrincipalArn": {
          "Ref": "AdminPrincipalArn"
        },
        "Type": "STANDARD",
        "AccessPolicies": [
          {
            "PolicyArn": {
              "Fn::Sub": "arn:${AWS::Partition}:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
            },
            "AccessScope": {
              "Type": "cluster"
            }
          }
        ]
      }
    },
    "NodeTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpPutResponseHopLimit": 1
          },
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "Encrypted": true,
                "VolumeType": "gp3",
                "VolumeSize": 80
              }
            }
          ]
        }
      }
    },
    "Workers0": {
      "Type": "AWS::EKS::Nodegroup",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "NodeRole": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Subnets": [
          {
            "Ref": "Private0"
          }
        ],
        "InstanceTypes": [
          {
            "Ref": "InstanceType"
          }
        ],
        "AmiType": "AL2023_x86_64_STANDARD",
        "CapacityType": "ON_DEMAND",
        "ScalingConfig": {
          "MinSize": 1,
          "DesiredSize": 1,
          "MaxSize": 3
        },
        "LaunchTemplate": {
          "Id": {
            "Ref": "NodeTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "NodeTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "NodeRepairConfig": {
          "Enabled": true
        }
      },
      "DependsOn": [
        "Egress0"
      ]
    },
    "Workers1": {
      "Type": "AWS::EKS::Nodegroup",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "NodeRole": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Subnets": [
          {
            "Ref": "Private1"
          }
        ],
        "InstanceTypes": [
          {
            "Ref": "InstanceType"
          }
        ],
        "AmiType": "AL2023_x86_64_STANDARD",
        "CapacityType": "ON_DEMAND",
        "ScalingConfig": {
          "MinSize": 1,
          "DesiredSize": 1,
          "MaxSize": 3
        },
        "LaunchTemplate": {
          "Id": {
            "Ref": "NodeTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "NodeTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "NodeRepairConfig": {
          "Enabled": true
        }
      },
      "DependsOn": [
        "Egress1"
      ]
    },
    "Workers2": {
      "Type": "AWS::EKS::Nodegroup",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "NodeRole": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Subnets": [
          {
            "Ref": "Private2"
          }
        ],
        "InstanceTypes": [
          {
            "Ref": "InstanceType"
          }
        ],
        "AmiType": "AL2023_x86_64_STANDARD",
        "CapacityType": "ON_DEMAND",
        "ScalingConfig": {
          "MinSize": 1,
          "DesiredSize": 1,
          "MaxSize": 3
        },
        "LaunchTemplate": {
          "Id": {
            "Ref": "NodeTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "NodeTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "NodeRepairConfig": {
          "Enabled": true
        }
      },
      "DependsOn": [
        "Egress2"
      ]
    },
    "PodIdentityAgent": {
      "Type": "AWS::EKS::Addon",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "AddonName": "eks-pod-identity-agent"
      },
      "DependsOn": [
        "Workers0",
        "Workers1",
        "Workers2"
      ]
    },
    "StorageRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "pods.eks.amazonaws.com"
              },
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonEBSCSIDriverPolicy"
          }
        ]
      }
    },
    "StorageDriver": {
      "Type": "AWS::EKS::Addon",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "AddonName": "aws-ebs-csi-driver",
        "PodIdentityAssociations": [
          {
            "RoleArn": {
              "Fn::GetAtt": [
                "StorageRole",
                "Arn"
              ]
            },
            "ServiceAccount": "ebs-csi-controller-sa"
          }
        ]
      },
      "DependsOn": "PodIdentityAgent"
    }
  },
  "Outputs": {
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "ClusterEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Cluster",
          "Endpoint"
        ]
      }
    },
    "VpcId": {
      "Value": {
        "Ref": "Vpc"
      }
    }
  }
}